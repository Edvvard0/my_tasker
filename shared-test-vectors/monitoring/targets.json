    {
      "name": "host_plain_name",
      "input": {
        "op": "host",
        "value": "example.com"
      },
      "expected": {
        "valid": true,
        "host": "example.com"
      }
    },
    {
      "name": "host_subdomain",
      "input": {
        "op": "host",
