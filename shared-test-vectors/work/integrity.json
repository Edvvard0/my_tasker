          }
        ],
        "payments": [
          {
            "id": "x",
            "paid_at": "2026-10-05T09:00:00Z",
            "amount": 5
          }
        ],
        "allocations": [
          {
            "id": "a",
            "payment_id": "x",
            "project_id": "p1",
            "change_request_id": "c1",
            "amount": 10
          }
        ]
      },
      "expected": [
        {
          "code": "change_request_mismatch",
          "id": "a",
          "excess": null
        },
        {
          "code": "over_allocated",
          "id": "x",
          "excess": 5
