# Copy to deploy/.env and fill in the values on the server. Never commit .env.
# Names only: no values live in the repository.

# Public IPv4 address (or hostname) that Caddy serves HTTPS on.
SERVER_IP=

# PostgreSQL (the password must be URL-safe: letters and digits, e.g. `openssl rand -hex 24`).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Secret for token signing and TOTP encryption, at least 32 characters: `openssl rand -hex 32`.
# Must not change after the owner was created (`python -m tasker.cli user create`): with another
# key the stored TOTP secret cannot be decrypted, login answers `owner_secret_unreadable` until
# `python -m tasker.cli user reset` creates new credentials (signed-in devices are unaffected).
APP_SECRET_KEY=

# Optional overrides (defaults: APP_ENV=prod, LOG_LEVEL=INFO).
APP_ENV=
LOG_LEVEL=

# Optional image overrides, e.g. a registry mirror when Docker Hub rate-limits.
PYTHON_IMAGE=
POSTGRES_IMAGE=
CADDY_IMAGE=
